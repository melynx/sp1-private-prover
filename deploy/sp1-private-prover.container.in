[Unit]
Description=Private SP1 prover-network compatible service
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/sp1-private-prover:local
ContainerName=sp1-private-prover
Network=sp1-private-prover.network
AddDevice=/dev/kfd
AddDevice=@RENDER_NODE@
@ADDITIONAL_RENDER_DEVICES@
GroupAdd=keep-groups
UserNS=keep-id
PodmanArgs=--shm-size=32g
Volume=@STATE_DIR@:/var/lib/sp1-private-prover:Z
Volume=@CIRCUIT_DIR@:/var/cache/sp1/circuits:ro,Z
Volume=@CONFIG_FILE@:/etc/sp1-private-prover/config.toml:ro,Z
Environment=HIP_VISIBLE_DEVICES=0
Environment=SP1_ROCM_ALLOCATOR=async
Environment=HOME=/var/lib/sp1-private-prover
Environment=SP1_ROCM_SERVER_LOG=/var/lib/sp1-private-prover/sp1-rocm-server.log
PublishPort=50051:50051
PublishPort=50052:50052
Tmpfs=/tmp:rw,nosuid,nodev
NoNewPrivileges=true
ReadOnly=true
DropCapability=all
HealthCmd=/usr/local/bin/sp1-private-prover --healthcheck
HealthInterval=30s
HealthStartPeriod=2m
HealthTimeout=3s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=default.target
